# Python runtime / generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local datasets, model outputs and experiment records
/cache/
/weights/
/results/
/logs/
/reports/
/tmp/
/data/*
!/data/splits.json
/configs/verification/
/configs/phase2_verification/

# Local paper extraction and reference code copies; retain source provenance/license
/references/*
!/references/provenance.json
!/references/official/
/references/official/*
!/references/official/LICENSE

# Defense against accidentally placing binary data outside normal output folders
*.nii
*.nii.gz
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors
*.pdf

# Local credentials / editor and OS files
.env
.env.*
!.env.example
.vscode/
.idea/
Thumbs.db
.DS_Store
